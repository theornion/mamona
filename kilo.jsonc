{
  "$schema": "https://app.kilo.ai/config.json",
  "model": "ollama/mamona-qwen14-64k",
  "small_model": "ollama/mamona-qwen9-64k",
  "share": "disabled",
  "snapshot": true,
  "autoupdate": "notify",
  "web_search": false,
  "provider": {
    "ollama": {
      "options": {
        "baseURL": "http://127.0.0.1:11436/v1",
        "timeout": 1800000,
        "chunkTimeout": 1800000
      },
      "whitelist": [
        "mamona-coder30-128k",
        "mamona-qwen14-64k",
        "mamona-qwen9-64k"
      ],
      "models": {
        "mamona-coder30-128k": {
          "name": "Mamona Coder 30B 128K — Heavy Exclusive",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 131072,
            "output": 32768
          }
        },
        "mamona-qwen14-64k": {
          "name": "Mamona Qwen 14B 64K — Medium",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 24576
          }
        },
        "mamona-qwen9-64k": {
          "name": "Mamona Qwen 9B 64K — Fast",
          "tool_call": true,
          "reasoning": true,
          "temperature": true,
          "attachment": false,
          "modalities": {
            "input": [
              "text"
            ],
            "output": [
              "text"
            ]
          },
          "limit": {
            "context": 65536,
            "output": 12288
          }
        }
      }
    }
  },
  "indexing": {
    "enabled": true,
    "provider": "ollama",
    "model": "nomic-embed-text",
    "dimension": 768,
    "vectorStore": "lancedb",
    "ollama": {
      "baseUrl": "http://127.0.0.1:11436"
    },
    "lancedb": {},
    "fileExtensions": [
      ".php",
      ".js",
      ".css",
      ".html",
      ".md",
      ".json",
      ".jsonc",
      ".sql",
      ".xml",
      ".ps1",
      ".sh"
    ],
    "searchMinScore": 0.48,
    "searchMaxResults": 12,
    "embeddingBatchSize": 24,
    "scannerMaxBatchRetries": 3
  },
  "compaction": {
    "auto": true,
    "threshold_percent": 62,
    "prune": true,
    "tail_turns": 4,
    "preserve_recent_tokens": 12000,
    "reserved": 14000
  },
  "agent": {
    "compaction": {
      "model": "ollama/mamona-qwen9-64k"
    }
  },
  "permission": {
    "external_directory": {
      "*": "allow"
    },
    "read": {
      "*": "allow"
    },
    "glob": {
      "*": "allow"
    },
    "grep": {
      "*": "allow"
    },
    "edit": {
      "*": "allow"
    },
    "write": {
      "*": "allow"
    },
    "bash": {
      "*": "allow"
    },
    "task": {
      "*": "allow"
    },
    "lsp": {
      "*": "allow"
    },
    "todoread": {
      "*": "allow"
    },
    "todowrite": "allow",
    "agent_manager": {
      "*": "deny"
    },
    "webfetch": "deny",
    "websearch": "deny",
    "doom_loop": "deny"
  }
}
