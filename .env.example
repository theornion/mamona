# Środowisko: development lub production
CMS_ENV=development

# W produkcji ustaw pełny publiczny adres bez końcowego ukośnika.
CMS_PUBLIC_URL=https://example.com

CMS_SITE_NAME=Twoja marka
CMS_LANGUAGE=pl-PL
CMS_TIMEZONE=Europe/Warsaw
CMS_PUBLISHER_NAME=Twoja marka
CMS_DEFAULT_AUTHOR=Redakcja
CMS_POST_IMAGE_DIRECTORY=images/posts

# Dane zaufania wymagane przed publikacją w CMS_ENV=production.
# Nie wpisuj fikcyjnych danych. Adres publiczny uzupełnia się także w panelu
# Ustawienia kontaktu, a prawdziwe biogramy — w rekordach autorów.
CMS_PUBLISHER_LEGAL_NAME=
CMS_EDITORIAL_CONTACT_EMAIL=
CMS_PRIVACY_CONTACT_EMAIL=
# Np. konkretny okres albo jednoznaczne kryteria usunięcia wiadomości.
CMS_CONTACT_RETENTION_POLICY=

# Pełna automatyczna publikacja pozostaje domyślnie wyłączona.
# Włącz dopiero po konfiguracji cyklicznego uruchamiania i CMS_PUBLIC_URL.
# Tryb --dry-run działa również przy wartości false.
CMS_AUTOMATIC_PUBLISHING=false
CMS_DAILY_PUBLICATION_LIMIT=5

# Kategorie premiowane podczas punktacji tematów, rozdzielone przecinkami.
CMS_PREFERRED_TOPIC_CATEGORIES=new-technologies,how-it-works,space,earth-nature,energy-climate,robotics-transport,materials-inventions,human-technology
# Opcjonalny aktualny pakiet CA używany przez klienta RSS/cURL.
CMS_FEED_CA_BUNDLE=

# Wspólny tryb pipeline'u: manual nie wykonuje płatnych wywołań API.
CMS_GENERATION_MODE=manual
# Dostawca dla trybu api: gemini (domyślny) albo openai.
CMS_GENERATION_PROVIDER=gemini
GEMINI_MODEL=gemini-2.5-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=3
GEMINI_INITIAL_BACKOFF_MS=750
GEMINI_API_MOCK=false
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_ATTEMPTS=3
OPENAI_API_MOCK=false
# Opcjonalna ścieżka do aktualnego pakietu CA dla cURL/OpenSSL.
OPENAI_CA_BUNDLE=

# Generator obrazów AI pozostaje bezwzględnie wyłączony w pierwszej wersji.
# Ręczny upload i pobieranie zweryfikowanych obrazów źródłowych nadal działają.
CMS_AI_IMAGE_GENERATION_ENABLED=false
CMS_SOURCE_IMAGE_PROVIDER=wikimedia
CMS_SOURCE_IMAGE_TIMEOUT_SECONDS=20
CMS_SOURCE_IMAGE_MAX_BYTES=12582912
CMS_SOURCE_IMAGE_MIN_WIDTH=800
CMS_SOURCE_IMAGE_MIN_HEIGHT=450
CMS_SOURCE_IMAGE_MAX_REDIRECTS=3

# Opcjonalna ścieżka do Pythona z Pillow. Wymagana do kadrowania i konwersji
# miniatur, jeżeli PHP nie ma rozszerzenia GD z obsługą WebP.
CMS_IMAGE_PROCESSOR_PYTHON=

# Przyszłe integracje API: wartości ustawiaj wyłącznie w środowisku serwera.
OPENAI_API_KEY=
GEMINI_API_KEY=
