RewriteEngine On

# Do not expose directory listings, deployment metadata, or configuration files.
Options -Indexes
RewriteRule (^|/)\.git(?:/|$) - [F,L]

<FilesMatch "^(?:contact-secrets\.php|admin-credentials\.json|\.env|.*\.(?:bak|conf|ini|json|log|sql|sqlite|zip))$">
    Require all denied
</FilesMatch>

RewriteCond %{HTTPS} !=on
RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# Google often checks this conventional, root-level favicon URL.
RewriteRule ^favicon\.ico$ images/icons/favicon.ico [L]
