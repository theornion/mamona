# Środowisko: development lub production
CMS_ENV=development

# W produkcji ustaw pełny publiczny adres bez końcowego ukośnika.
CMS_PUBLIC_URL=https://example.com

CMS_SITE_NAME=Twoja marka
CMS_LANGUAGE=pl-PL
CMS_TIMEZONE=Europe/Warsaw
CMS_PUBLISHER_NAME=Twoja marka
CMS_DEFAULT_AUTHOR=Redakcja
CMS_POST_IMAGE_DIRECTORY=images/posts

# Dane zaufania wymagane przed publikacją w CMS_ENV=production.
# Nie wpisuj fikcyjnych danych. Adres publiczny uzupełnia się także w panelu
# Ustawienia kontaktu, a prawdziwe biogramy — w rekordach autorów.
CMS_PUBLISHER_LEGAL_NAME=
CMS_EDITORIAL_CONTACT_EMAIL=
CMS_PRIVACY_CONTACT_EMAIL=
# Np. konkretny okres albo jednoznaczne kryteria usunięcia wiadomości.
CMS_CONTACT_RETENTION_POLICY=

# Pełna automatyczna publikacja pozostaje domyślnie wyłączona.
# Włącz dopiero po konfiguracji cyklicznego uruchamiania i CMS_PUBLIC_URL.
# Tryb --dry-run działa również przy wartości false.
CMS_AUTOMATIC_PUBLISHING=false
CMS_DAILY_PUBLICATION_LIMIT=5

# Kategorie premiowane podczas punktacji tematów, rozdzielone przecinkami.
CMS_PREFERRED_TOPIC_CATEGORIES=new-technologies,how-it-works,space,earth-nature,energy-climate,robotics-transport,materials-inventions,human-technology
# Opcjonalny aktualny pakiet CA używany przez klienta RSS/cURL.
CMS_FEED_CA_BUNDLE=
# Transport RSS: połączenie, cały transfer oraz wykrywanie połączeń bez postępu.
CMS_FEED_CONNECT_TIMEOUT_SECONDS=8
CMS_FEED_TRANSFER_TIMEOUT_SECONDS=45
CMS_FEED_LOW_SPEED_LIMIT=32
CMS_FEED_LOW_SPEED_TIME_SECONDS=20
CMS_FEED_MAX_ATTEMPTS=3
# Łączny budżet prób pojedynczego źródła w jobie oraz próg stanu unavailable.
CMS_FEED_JOB_BUDGET_SECONDS=150
CMS_FEED_FAILURE_THRESHOLD=3
# PHP CLI uĹĽywane przez workery uruchamiane z Apache/XAMPP.
CMS_PHP_CLI=C:\xampp\php\php.exe

# Wspólny tryb pipeline'u: manual nie wykonuje płatnych wywołań API.
CMS_GENERATION_MODE=manual
# Dostawca dla trybu api: gemini (domyślny) albo openai.
CMS_GENERATION_PROVIDER=gemini
GEMINI_MODEL=gemini-3.1-flash-lite
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_ATTEMPTS=3
GEMINI_INITIAL_BACKOFF_MS=750
GEMINI_API_MOCK=false
GEMINI_QUOTA_PROJECT=default
GEMINI_RPM_TARGET=10
GEMINI_TPM_TARGET=250000
GEMINI_RPD_TARGET=500
GEMINI_MODEL_CONCURRENCY=1
GEMINI_QUOTA_LEASE_SECONDS=180
GEMINI_QUOTA_RESET_TIMEZONE=UTC
GEMINI_MODEL_FALLBACKS=
# Testy nie wykonaja polaczenia live bez jawnego opt-in.
CMS_ALLOW_LIVE_GEMINI_TEST=false
# Worker batch: bezpieczny domyślny poziom dla Gemini Free Tier; maksymalnie 2.
CMS_BATCH_WORKER_CONCURRENCY=1
CMS_BATCH_MAX_TOPICS=50
CMS_BATCH_LEASE_SECONDS=900
CMS_BATCH_RATE_LIMIT_BACKOFF_SECONDS=60
# Automatyczny wybór tematów i uruchamianie pełnego batcha. Nie publikuje.
FULL_AUTO_ENABLED=false
CMS_AUTOMATIC_DISPATCH_PAUSED=false
FULL_AUTO_MAX_TOPICS_PER_RUN=3
FULL_AUTO_MAX_TOPICS_PER_DAY=10
FULL_AUTO_MINIMUM_SCORE=70
FULL_AUTO_MINIMUM_INDEPENDENT_SOURCES=2
FULL_AUTO_REQUIRE_PRIMARY_SOURCE=true
FULL_AUTO_MAXIMUM_AGE_HOURS=72
FULL_AUTO_ALLOWED_CATEGORIES=new-technologies,how-it-works,space,earth-nature,energy-climate,robotics-transport,materials-inventions,human-technology
FULL_AUTO_ALLOWED_RISKS=low
# Maksymalna liczba tematów wybieranych przez „top N” i pojedynczy batch (1–25).
CMS_TOPICS_BATCH_LIMIT=10
OPENAI_MODEL=gpt-5.6-terra
OPENAI_IMAGE_MODEL=gpt-image-2
OPENAI_API_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60
OPENAI_MAX_ATTEMPTS=3
TITLE_REPAIR_MAX_ATTEMPTS=2
OPENAI_API_MOCK=false
# Opcjonalna ścieżka do aktualnego pakietu CA dla cURL/OpenSSL.
OPENAI_CA_BUNDLE=

# Generator obrazów AI pozostaje bezwzględnie wyłączony w pierwszej wersji.
# Ręczny upload i pobieranie zweryfikowanych obrazów źródłowych nadal działają.
CMS_AI_IMAGE_GENERATION_ENABLED=false
CMS_SOURCE_IMAGE_PROVIDER=wikimedia
CMS_SOURCE_IMAGE_MOCK=false
CMS_SOURCE_IMAGE_TIMEOUT_SECONDS=20
CMS_SOURCE_IMAGE_MAX_BYTES=12582912
CMS_SOURCE_IMAGE_MIN_WIDTH=800
CMS_SOURCE_IMAGE_MIN_HEIGHT=450
CMS_SOURCE_IMAGE_MAX_REDIRECTS=3
CMS_SOURCE_IMAGE_QUERY_BUDGET_PER_SLOT=12
CMS_SOURCE_IMAGE_CANDIDATE_BUDGET_PER_QUERY=20
CMS_SOURCE_IMAGE_PROVIDER_CACHE_SECONDS=86400
# Klucze pozostają wyłącznie w środowisku procesu; brak klucza pomija provider.
SMITHSONIAN_API_KEY=
EUROPEANA_API_KEY=
PEXELS_API_KEY=
PEXELS_API_HOURLY_LIMIT=180
# Opcjonalne wewnętrzne/instytucjonalne katalogi JSON zwracające pełne dane per asset.
CMS_ESO_ASSET_CATALOG_URL=
CMS_USGS_ASSET_CATALOG_URL=
CMS_NCI_ASSET_CATALOG_URL=

# Opcjonalna ścieżka do Pythona z Pillow. Wymagana do kadrowania i konwersji
# miniatur, jeżeli PHP nie ma rozszerzenia GD z obsługą WebP.
CMS_IMAGE_PROCESSOR_PYTHON=

# Neutralna warstwa miejsc reklamowych. Domyślnie nie renderuje żadnych slotów.
# Podgląd pokazuje wyłącznie techniczne placeholdery i jest ignorowany w production.
CMS_ADS_ENABLED=false
CMS_ADS_PREVIEW=false
CMS_ADS_ALLOWED_PLACEMENTS=page-top,feed-inline,article-inline,post-article
CMS_ADS_MAX_SLOTS_PER_PAGE=5
CMS_ADS_MAX_INLINE_SLOTS=3
CMS_ADS_MIN_BLOCK_GAP=2

# Przyszłe integracje API: wartości ustawiaj wyłącznie w środowisku serwera.
OPENAI_API_KEY=
GEMINI_API_KEY=
